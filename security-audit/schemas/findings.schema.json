{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local-security-scan/findings.schema.json",
  "title": "Local security scan findings",
  "type": "object",
  "required": ["target", "passes", "findings", "non_findings"],
  "additionalProperties": false,
  "properties": {
    "target": {"type": "string", "minLength": 1},
    "passes": {"type": "integer", "minimum": 1},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "non_findings": {"type": "array", "items": {"$ref": "#/$defs/rejected"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)+$"},
    "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence": {
      "type": "object",
      "required": ["id", "label", "path", "startLine", "role", "code", "explanation"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "startLine": {"type": "integer", "minimum": 1},
        "endLine": {"type": "integer", "minimum": 1},
        "language": {"type": "string"},
        "role": {"enum": ["user_input", "entrypoint", "propagation", "root_control", "sink", "outcome", "expected_control"]},
        "code": {"type": "string", "minLength": 1},
        "explanation": {"type": "string", "minLength": 20}
      }
    },
    "finding": {
      "type": "object",
      "required": ["id", "title", "cwe", "severity", "severity_rationale",
        "confidence", "attacker", "entry", "sink", "dataflow", "control",
        "impact", "prerequisites", "counterevidence", "codeEvidence",
        "rootCause", "validation", "attackPath",
        "remediation", "remediationTests", "preventiveControls", "status"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 8},
        "cwe": {"type": "string", "pattern": "^CWE-[0-9]+$"},
        "severity": {"enum": ["critical", "high", "medium", "low"]},
        "severity_rationale": {"type": "string", "minLength": 20},
        "confidence": {"enum": ["high", "medium", "low"]},
        "attacker": {"type": "string", "minLength": 10},
        "entry": {"type": "string", "minLength": 1},
        "sink": {"type": "string", "minLength": 1},
        "dataflow": {"type": "string", "minLength": 10},
        "control": {"type": "string", "minLength": 1},
        "impact": {"type": "string", "minLength": 10},
        "prerequisites": {"type": "string", "minLength": 1},
        "counterevidence": {"type": "string", "minLength": 10},
        "codeEvidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "rootCause": {"type": "object",
          "required": ["summary", "evidenceRefs"],
          "properties": {
            "summary": {"type": "string", "minLength": 20},
            "evidenceRefs": {"$ref": "#/$defs/evidenceRefs"}
          }},
        "validation": {"type": "object",
          "required": ["method", "summary", "evidenceRefs", "assertions", "limitations"],
          "properties": {
            "method": {"type": "string", "minLength": 1},
            "summary": {"type": "string", "minLength": 20},
            "evidenceRefs": {"$ref": "#/$defs/evidenceRefs"},
            "assertions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }},
        "attackPath": {"type": "object",
          "required": ["summary", "dataflow", "reachability", "impact", "likelihood",
                       "vector", "authScope", "crossBoundary", "blindspots", "policyDecision"],
          "properties": {
            "summary": {"type": "string", "minLength": 10},
            "dataflow": {"type": "object",
              "required": ["source", "sink", "outcome", "evidenceRefs"],
              "properties": {
                "source": {"type": "string", "minLength": 1},
                "sink": {"type": "string", "minLength": 1},
                "outcome": {"type": "string", "minLength": 1},
                "evidenceRefs": {"$ref": "#/$defs/evidenceRefs"}
              }},
            "reachability": {"type": "object",
              "required": ["attacker", "entrypoint", "outcome"],
              "properties": {
                "attacker": {"type": "string", "minLength": 1},
                "entrypoint": {"type": "string", "minLength": 1},
                "outcome": {"type": "string", "minLength": 1}
              }},
            "impact": {"type": "object",
              "required": ["level", "why"],
              "properties": {
                "level": {"enum": ["high", "medium", "low", "ignore", "unknown"]},
                "why": {"type": "string", "minLength": 1}}},
            "likelihood": {"type": "object",
              "required": ["level", "why"],
              "properties": {
                "level": {"enum": ["high", "medium", "low", "ignore", "unknown"]},
                "why": {"type": "string", "minLength": 1}}},
            "vector": {"enum": ["remote", "local_network", "localhost", "none", "unknown"]},
            "authScope": {"enum": ["public", "internal-only", "admin-only", "unknown"]},
            "crossBoundary": {"type": "string", "minLength": 10},
            "blindspots": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "policyDecision": {"const": "report"}
          }},
        "remediation": {"type": "string", "minLength": 10},
        "remediationTests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "preventiveControls": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "status": {"enum": ["hypothesis", "validated"]}
      }
    },
    "rejected": {
      "type": "object",
      "required": ["id", "title", "reason"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 10}
      }
    }
  }
}
