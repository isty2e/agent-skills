filters:
  and:
    - 'file.inFolder("Knowledge/Candidates")'
    - 'record_type == "candidate"'
formulas:
  title_link: 'file.asLink(if(title.isEmpty(), file.name, title))'
properties:
  formula.title_link:
    displayName: Title
  tags:
    displayName: Topics
  status:
    displayName: Status
  knowledge_kind:
    displayName: Kind
  evidence_state:
    displayName: Evidence
  canonical_id:
    displayName: Canonical owner
  updated:
    displayName: Updated
views:
  - type: table
    name: Inbox
    filters:
      and:
        - 'status == "pending"'
    order:
      - formula.title_link
      - tags
      - status
      - knowledge_kind
      - evidence_state
      - updated
  - type: table
    name: Ready
    filters:
      and:
        - 'status == "ready"'
    order:
      - formula.title_link
      - tags
      - knowledge_kind
      - evidence_state
      - updated
  - type: table
    name: Deferred
    filters:
      and:
        - 'status == "deferred"'
    order:
      - formula.title_link
      - tags
      - knowledge_kind
      - evidence_state
      - updated
  - type: table
    name: Rejected
    filters:
      and:
        - 'status == "rejected"'
    order:
      - formula.title_link
      - tags
      - knowledge_kind
      - updated
  - type: table
    name: Integrated
    filters:
      and:
        - 'status == "integrated"'
    order:
      - formula.title_link
      - tags
      - status
      - canonical_id
      - updated
  - type: table
    name: Contested
    filters:
      and:
        - 'status == "contested"'
    order:
      - formula.title_link
      - tags
      - status
      - canonical_id
      - updated
