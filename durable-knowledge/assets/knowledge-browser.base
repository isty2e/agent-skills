filters:
  or:
    - 'file.inFolder("Knowledge/Candidates")'
    - 'file.inFolder("Knowledge/Canonical")'
formulas:
  title_link: 'file.asLink(if(title.isEmpty(), file.name, title))'
properties:
  formula.title_link:
    displayName: Title
  status:
    displayName: Status
  lifecycle:
    displayName: Lifecycle
  knowledge_kind:
    displayName: Kind
  evidence_state:
    displayName: Evidence
  canonical_id:
    displayName: Canonical owner
  updated:
    displayName: Updated
views:
  - type: table
    name: Candidate inbox
    filters:
      and:
        - 'record_type == "candidate"'
        - 'status == "pending"'
    order:
      - formula.title_link
      - status
      - knowledge_kind
      - evidence_state
      - updated
  - type: table
    name: Ready for curation
    filters:
      and:
        - 'record_type == "candidate"'
        - 'status == "ready"'
    order:
      - formula.title_link
      - knowledge_kind
      - evidence_state
      - updated
  - type: table
    name: Deferred candidates
    filters:
      and:
        - 'record_type == "candidate"'
        - 'status == "deferred"'
    order:
      - formula.title_link
      - knowledge_kind
      - evidence_state
      - updated
  - type: table
    name: Canonical knowledge
    filters:
      and:
        - 'record_type == "canonical"'
        - 'lifecycle != "retired"'
    order:
      - formula.title_link
      - lifecycle
      - knowledge_kind
      - evidence_state
      - updated
  - type: table
    name: Contested knowledge
    filters:
      and:
        - 'record_type == "canonical"'
        - or:
            - 'lifecycle == "contested"'
            - 'evidence_state == "contested"'
    order:
      - formula.title_link
      - lifecycle
      - knowledge_kind
      - evidence_state
      - updated
  - type: table
    name: Integrated candidates
    filters:
      and:
        - 'record_type == "candidate"'
        - or:
            - 'status == "integrated"'
            - 'status == "contested"'
    order:
      - formula.title_link
      - status
      - canonical_id
      - updated
  - type: table
    name: Retired knowledge
    filters:
      and:
        - 'record_type == "canonical"'
        - 'lifecycle == "retired"'
    order:
      - formula.title_link
      - knowledge_kind
      - evidence_state
      - updated
